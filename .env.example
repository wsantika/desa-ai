# ==========================================
# DesaAI Environment Configuration Template
# Salin file ini menjadi .env.local untuk dev lokal
# ==========================================

# 1. Database Connection (PostgreSQL)
# Jika menggunakan PostgreSQL dari Docker di laptop:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/desa_ai?schema=public"

# 2. AI / LLM Provider Keys
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 3. App Settings
PORT=3000
VITE_APP_TITLE="DesaAI - Smart Village Operating System"
